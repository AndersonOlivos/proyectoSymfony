{# templates/base_logged.html.twig #}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Padel App{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-gray-100 h-screen w-screen flex items-center justify-center p-4 lg:p-6 overflow-hidden">

<div class="bg-white w-full h-full max-w-[1600px] rounded-[40px] shadow-2xl flex overflow-hidden relative">

    <aside class="w-24 h-full flex flex-col items-center py-8 border-r border-gray-100 z-20 bg-white">
        <div class="mb-12">
            <a href="{{ path('app_app') }}" class="flex flex-col items-center text-2xl font-bold text-gray-900 tracking-tighter leading-none group">
                <span>Padel</span>
                <span class="text-gray-400 group-hover:text-black transition-colors">Rank.</span>
            </a>
        </div>
        <nav class="flex-1 flex flex-col gap-8 w-full px-4">

            {# Definimos una variable por defecto para evitar errores si no se pasa #}
            {% set current_page = current_page|default('') %}

            <a href="{{ path('app_app') }}"
               class="group relative flex items-center justify-center w-full h-12 rounded-xl transition-all duration-300
       {{ current_page == 'home' ? 'bg-black text-white shadow-lg shadow-gray-300' : 'text-gray-400 hover:text-white hover:bg-black' }}">

                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                <span class="absolute left-14 bg-gray-900 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap z-50 pointer-events-none">
            Inicio
        </span>
            </a>

            <a href="{{ path('app_ranking_general') }}"
               class="group relative flex items-center justify-center w-full h-12 rounded-xl transition-all duration-300
       {{ current_page == 'rankings' ? 'bg-black text-white shadow-lg shadow-gray-300' : 'text-gray-400 hover:text-white hover:bg-black' }}">

                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
                <span class="absolute left-14 bg-gray-900 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap z-50 pointer-events-none">
            Rankings Generales
        </span>
            </a>

            <a href="{{ path('app_jugadores_favoritos') }}"
               class="group relative flex items-center justify-center w-full h-12 rounded-xl transition-all duration-300
       {{ current_page == 'favorites' ? 'bg-black text-white shadow-lg shadow-gray-300' : 'text-gray-400 hover:text-white hover:bg-black' }}">

                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
                <span class="absolute left-14 bg-gray-900 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap z-50 pointer-events-none">
            Mis Jugadores
        </span>
            </a>

        </nav>
        <div class="flex flex-col gap-4 w-full px-4">
            <a href="#" class="group relative flex items-center justify-center w-full h-12 rounded-xl text-gray-400 hover:text-red-500 hover:bg-red-50 transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
                <span class="absolute left-14 bg-gray-900 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap z-50 pointer-events-none">Salir</span>
            </a>
        </div>
    </aside>

    <main class="flex-1 flex flex-col bg-gray-50/50 h-full relative overflow-hidden">

        <header class="w-full h-24 flex items-center justify-between px-10 py-6 shrink-0 z-10">

            <div class="flex-1 max-w-xl">
                {% block header_search %}
                {% endblock %}
            </div>

            <div class="flex items-center gap-4 ml-4">
                <div class="flex items-center gap-3 pl-4 border-l border-gray-200">
                    <div class="text-right hidden md:block">
                        <p class="text-sm font-semibold text-gray-900">Usuario Demo</p>
                        <p class="text-xs text-gray-500">Admin</p>
                    </div>
                    <div class="h-10 w-10 rounded-full bg-gray-200 overflow-hidden border-2 border-white shadow-sm">
                        <img src="https://i.pravatar.cc/150?img=68" alt="Avatar" class="h-full w-full object-cover">
                    </div>
                </div>
            </div>
        </header>

        <div class="flex-1 overflow-y-auto no-scrollbar p-10 pt-4">
            {% block body %}{% endblock %}
        </div>

    </main>
</div>
</body>
</html>
