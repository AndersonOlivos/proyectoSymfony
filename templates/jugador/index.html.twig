{% extends 'base_logged.html.twig' %}

{# --- MOCK DATA ACTUALIZADO: Más rankings y opiniones para simular la paginación --- #}
{% set player = {
    name: 'Alejandro Galán',
    position: 'Revés',
    nationality: 'España',
    birth_date: '15/05/1996',
    height: '1.86m',
    image: 'https://images.unsplash.com/photo-1599474924187-334a405be631?q=80&w=2070&auto=format&fit=crop',
    score_avg: 9.8,
    total_votes: 1240,
    categories: ['Rematador', 'Potencia', 'Agresivo'],
    active_challenges: [
        { name: 'El Mejor Rematador', description: 'Crea tu Top 10 de rematadores.', category_required: 'Rematador' },
        { name: 'Jugadores Más Agresivos', description: 'Ranking de los jugadores que más arriesgan.', category_required: 'Agresivo' },
        { name: 'Potencia Pura', description: '¿Quién le pega más fuerte a la bola?', category_required: 'Potencia' }
    ]
} %}

{% set reviews = [
    { user: 'JuanPadel', avatar: 'https://i.pravatar.cc/150?u=1', score: 10, comment: 'Es increíble la potencia que tiene en el remate. El mejor ahora mismo.', date: 'Hace 2 días' },
    { user: 'Marta_99', avatar: 'https://i.pravatar.cc/150?u=5', score: 9, comment: 'A veces arriesga demasiado, pero es puro espectáculo.', date: 'Hace 5 días' },
    { user: 'PadelFan23', avatar: 'https://i.pravatar.cc/150?u=8', score: 8, comment: 'Buen jugador pero le falta consistencia en globos.', date: 'Hace 1 semana' }
] %}

{% block title %}{{ jugador.nombre }} - Detalle{% endblock %}

{% block body %}

    <div class="mb-6">
        <a href="{{ path('app_app') }}" class="inline-flex items-center gap-2 text-gray-500 hover:text-black transition-colors font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Volver al inicio
        </a>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-8 pb-10">

        <div class="xl:col-span-1 space-y-8">
            <div class="bg-white rounded-[30px] p-4 shadow-sm relative group overflow-hidden sticky top-6">
                <div class="h-[400px] w-full rounded-[25px] overflow-hidden relative">
                    <img src="{{ jugador.imagen }}" alt="{{ jugador.nombre }}" class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500">
                    <span class="absolute top-4 left-4 bg-black/70 backdrop-blur-md text-white px-3 py-1 rounded-lg text-xs font-bold uppercase tracking-wide">
                        {{ jugador.lado }}
                    </span>
                    <button class="absolute top-4 right-4 bg-white/20 backdrop-blur-md hover:bg-white text-white hover:text-red-500 p-2.5 rounded-full transition-all duration-300 group/fav">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transition-transform group-active/fav:scale-75" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                        </svg>
                    </button>
                </div>

                <div class="pt-6 px-2 pb-2 text-center">
                    <h1 class="text-3xl font-bold text-gray-900 tracking-tight mb-1">{{ jugador.nombre }}</h1>
                    <div class="flex flex-wrap justify-center gap-2 mb-4">
                        {% for cat in player.categories %}
                            <span class="bg-gray-100 text-gray-600 px-2 py-1 rounded-md text-xs font-bold uppercase tracking-wider">{{ cat }}</span>
                        {% endfor %}
                    </div>
                    <div class="flex justify-center items-center gap-2 text-gray-500 text-sm font-medium mb-6">
                        <span class="flex justify-center items-center gap-1"><img src="https://flagsapi.com/{{ jugador.nacionalidad }}/flat/32.png">  {{ jugador.nacionalidad }}</span>
                        <span>•</span>
                        <span>{{ jugador.fecha_nacimiento }}</span>
                    </div>
                    <div class="bg-gray-50 rounded-2xl p-4 flex justify-between items-center">
                        <div class="text-left">
                            <p class="text-xs text-gray-400 uppercase font-bold">Nota Media</p>
                            <p class="text-xs text-gray-500">{{ player.total_votes }} valoraciones</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-4xl font-black text-gray-900">{{ player.score_avg }}</span>
                            <svg class="w-6 h-6 text-yellow-400 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="xl:col-span-2 space-y-8">

            <div class="bg-white border border-gray-100 rounded-[30px] p-8 shadow-sm">
                <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                    <div>
                        <h3 class="text-xl font-bold text-gray-900">Tu valoración personal</h3>
                        <p class="text-gray-500 text-sm">Puntúa a {{ player.name }} y deja tu huella.</p>
                    </div>
                    <div class="flex items-center gap-1">
                        {% for i in 1..5 %}
                            <button class="group focus:outline-none transition-transform active:scale-90">
                                <svg class="w-10 h-10 text-gray-200 hover:text-yellow-400 transition-colors fill-current" viewBox="0 0 20 20">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                </svg>
                            </button>
                        {% endfor %}
                    </div>
                </div>
                <div class="mt-6 bg-gray-50 p-4 rounded-2xl">
                    <textarea class="w-full bg-transparent border-none text-sm focus:ring-0 placeholder-gray-400 resize-none" rows="2" placeholder="Escribe tu opinión sobre el juego de {{ player.name }}..."></textarea>
                    <div class="flex justify-end mt-2 border-t border-gray-200 pt-3">
                        <button class="bg-black text-white px-6 py-2 rounded-xl text-sm font-semibold hover:bg-gray-800 transition-colors shadow-lg shadow-gray-200">
                            Publicar Valoración
                        </button>
                    </div>
                </div>
            </div>


            <div class="bg-black text-white rounded-[30px] p-8 shadow-xl relative overflow-hidden">
                <div class="relative z-10">
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h2 class="text-2xl font-bold">Rankings Activos 🏆</h2>
                            <p class="text-gray-400 text-sm mt-1">Participa en las categorías oficiales de este jugador.</p>
                        </div>
                        <span class="bg-white/10 px-3 py-1 rounded-full text-xs font-mono">1 / 2</span>
                    </div>

                    <div class="space-y-4 mb-6">
                        {% for challenge in player.active_challenges %}
                            <div class="bg-white/10 backdrop-blur-sm border border-white/10 rounded-2xl p-5 hover:bg-white/20 transition-all cursor-pointer group">
                                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                                    <div>
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="bg-yellow-400 text-black text-[10px] font-black px-1.5 py-0.5 rounded uppercase tracking-wider">Oficial</span>
                                            <h3 class="text-lg font-bold group-hover:text-yellow-400 transition-colors">{{ challenge.name }}</h3>
                                        </div>
                                        <p class="text-gray-300 text-xs md:text-sm">{{ challenge.description }}</p>
                                    </div>
                                    <button class="shrink-0 bg-white text-black px-5 py-2.5 rounded-xl text-xs font-bold uppercase hover:bg-gray-200 transition-colors">
                                        Crear Top 10
                                    </button>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="flex justify-center items-center gap-4 pt-2 border-t border-white/10">
                        <button class="p-2 rounded-full hover:bg-white/20 text-gray-400 hover:text-white disabled:opacity-50 transition-colors" disabled>
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                        </button>
                        <div class="flex gap-2">
                            <button class="w-2 h-2 rounded-full bg-white"></button>
                            <button class="w-2 h-2 rounded-full bg-white/30 hover:bg-white/50"></button>
                        </div>
                        <button class="p-2 rounded-full hover:bg-white/20 text-gray-400 hover:text-white transition-colors">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                        </button>
                    </div>
                </div>

                <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-br from-blue-900 to-purple-900 rounded-full blur-3xl opacity-40 -mr-20 -mt-20 pointer-events-none"></div>
            </div>


            <div class="bg-white rounded-[30px] p-8 shadow-sm">
                <div class="flex items-center justify-between mb-8">
                    <h3 class="text-xl font-bold text-gray-900">Opiniones</h3>

                    <select class="bg-gray-50 border-none text-xs font-medium text-gray-500 rounded-lg focus:ring-0 cursor-pointer">
                        <option>Más recientes</option>
                        <option>Mejor valoradas</option>
                    </select>
                </div>

                <div class="space-y-8">
                    {% for review in reviews %}
                        <div class="flex gap-4 animate-fade-in-up">
                            <img src="{{ review.avatar }}" alt="User" class="w-11 h-11 rounded-full bg-gray-200 shadow-sm border border-white">
                            <div class="flex-1">
                                <div class="flex justify-between items-start mb-1">
                                    <div>
                                        <h4 class="text-sm font-bold text-gray-900">{{ review.user }}</h4>
                                        <p class="text-[11px] text-gray-400 font-medium uppercase tracking-wide">{{ review.date }}</p>
                                    </div>
                                    <span class="flex items-center gap-1 text-xs font-bold text-black bg-gray-100 px-2 py-1 rounded-lg border border-gray-200">
                                        ★ {{ review.score }}
                                    </span>
                                </div>
                                <p class="text-sm text-gray-600 leading-relaxed mt-1">{{ review.comment }}</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <div class="mt-10 text-center border-t border-gray-100 pt-6">
                    <button class="text-sm font-semibold text-gray-500 hover:text-black transition-colors flex items-center justify-center gap-2 mx-auto w-full py-2 hover:bg-gray-50 rounded-xl">
                        <span>Cargar más opiniones</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                </div>
            </div>

        </div>
    </div>
{% endblock %}
