{# templates/app/_lista_jugadores.html.twig #}

{% for jugador in jugadores %}
    {# 1. CAMBIO: Convertimos el DIV principal en un A y añadimos 'block' #}
    <a href="{{ path('app_jugador', { 'id': jugador.id }) }}"
       class="block bg-white rounded-[25px] p-3 border border-gray-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group cursor-pointer">

        <div class="relative h-64 rounded-[20px] overflow-hidden">
            <img src="{{ jugador.imagen }}"
                 alt="{{ jugador.nombre }}"
                 class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500">

            <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-60 group-hover:opacity-80 transition-opacity"></div>

            <span class="absolute bottom-3 left-3 bg-white/90 backdrop-blur text-black text-[10px] font-bold px-3 py-1 rounded-lg uppercase tracking-wide">
                {{ jugador.lado }}
            </span>
        </div>

        <div class="pt-4 px-2 pb-2">
            <div class="flex justify-between items-center mb-2">
                <h3 class="text-lg font-bold text-gray-900 leading-tight truncate w-3/4">
                    {{ jugador.nombre }}
                </h3>
            </div>

            <div class="flex justify-between items-center mt-3 pt-3 border-t border-gray-50">
                <div class="flex items-center gap-1">
                    <span class="text-yellow-400 text-sm">★</span>
                    <span class="text-xs font-bold text-gray-700">{{ jugador.puntos }} pts</span>
                </div>

                {# 2. CAMBIO: Esto ahora es un SPAN visual, ya no es un link independiente #}
                <span class="text-xs font-medium text-gray-400 group-hover:text-black transition-colors flex items-center gap-1">
                    Ver perfil
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </span>
            </div>
        </div>
    </a>
{% else %}
    <div class="col-span-1 sm:col-span-2 lg:col-span-4 text-center py-20">
        <p class="text-gray-500 text-lg">No se encontraron jugadores con ese nombre.</p>
    </div>
{% endfor %}
