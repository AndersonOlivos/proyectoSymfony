{% extends 'base_logged.html.twig' %}
{% set current_page = 'favorites'%}


{# --- MOCK DATA: Tus jugadores favoritos --- #}
{% set favorites = [
    {
        id: 1,
        name: 'Ale Galán',
        rank: 1,
        points: 12405,
        position: 'Revés',
        image: 'https://ui-avatars.com/api/?name=Ale+Galan&background=0D8ABC&color=fff&size=200',
        partner: 'F. Chingotto'
    },
    {
        id: 2,
        name: 'Arturo Coello',
        rank: 2,
        points: 11950,
        position: 'Drive',
        image: 'https://ui-avatars.com/api/?name=Arturo+Coello&background=random&size=200',
        partner: 'A. Tapia'
    },
    {
        id: 3,
        name: 'Bea González',
        rank: 4,
        points: 9800,
        position: 'Revés',
        image: 'https://ui-avatars.com/api/?name=Bea+Gonzalez&background=FF69B4&color=fff&size=200',
        partner: 'Delfi Brea'
    },
    {
        id: 4,
        name: 'Paquito Navarro',
        rank: 7,
        points: 6500,
        position: 'Revés',
        image: 'https://ui-avatars.com/api/?name=Paquito+Navarro&background=random&size=200',
        partner: 'J. Lebrón'
    }
] %}

{% block title %}Mis Favoritos{% endblock %}

{% block body %}

    <div class="flex flex-col md:flex-row justify-between items-end mb-10 gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight mb-2">Mis Favoritos ❤️</h1>
            <p class="text-gray-500">Sigue de cerca a tus jugadores preferidos y no te pierdas sus estadísticas.</p>
        </div>

        <div class="bg-white px-4 py-2 rounded-xl border border-gray-200 shadow-sm text-sm font-medium text-gray-600">
            Tienes <span class="font-bold text-black" id="fav-count">{{ favorites|length }}</span> jugadores guardados
        </div>
    </div>

    {% if favorites is empty %}

        <div class="text-center py-20 bg-gray-50 rounded-[30px] border border-dashed border-gray-300">
            <div class="bg-white w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 shadow-sm">
                <svg class="w-10 h-10 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Aún no tienes favoritos</h3>
            <p class="text-gray-500 mb-6 max-w-md mx-auto">Explora el ranking mundial y añade a los jugadores que más te gusten para verlos aquí.</p>
            <a href="{{ path('app_rankings') }}" class="bg-black text-white px-6 py-3 rounded-xl font-bold hover:bg-gray-800 transition-colors">
                Explorar Jugadores
            </a>
        </div>

    {% else %}

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" id="favorites-grid">
            {% for player in favorites %}
                <div class="bg-white rounded-[25px] overflow-hidden border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group relative" id="card-{{ player.id }}">

                    <button onclick="removeFavorite({{ player.id }})"
                            class="absolute top-4 right-4 z-20 bg-white/90 backdrop-blur text-red-500 p-2.5 rounded-full shadow-sm hover:bg-red-50 hover:scale-110 transition-all group-hover:opacity-100"
                            title="Quitar de favoritos">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
                        </svg>
                    </button>

                    <div class="h-64 relative overflow-hidden bg-gray-100">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent z-10"></div>
                        <img src="{{ player.image }}" alt="{{ player.name }}" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500">

                        <span class="absolute top-4 left-4 z-20 bg-black/30 backdrop-blur-md text-white text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded border border-white/20">
                            {{ player.position }}
                        </span>

                        <div class="absolute bottom-4 left-4 z-20 text-white">
                            <p class="text-xs font-medium opacity-90 mb-0.5">Ranking #{{ player.rank }}</p>
                            <h3 class="text-xl font-bold leading-tight">{{ player.name }}</h3>
                        </div>
                    </div>

                    <div class="p-5">
                        <div class="flex justify-between items-center mb-4">
                            <div>
                                <p class="text-xs text-gray-400 font-semibold uppercase">Puntos</p>
                                <p class="text-lg font-black text-gray-900">{{ player.points|number_format(0, ',', '.') }}</p>
                            </div>
                            <div class="text-right">
                                <p class="text-xs text-gray-400 font-semibold uppercase">Pareja</p>
                                <p class="text-sm font-bold text-gray-900">{{ player.partner }}</p>
                            </div>
                        </div>

                        <button class="w-full py-3 rounded-xl border-2 border-gray-100 text-gray-700 font-bold text-sm hover:border-black hover:text-black hover:bg-gray-50 transition-all">
                            Ver Perfil Completo
                        </button>
                    </div>
                </div>
            {% endfor %}
        </div>

    {% endif %}

    <script>
        function removeFavorite(id) {
            if(confirm('¿Seguro que quieres quitar a este jugador de tus favoritos?')) {
                const card = document.getElementById('card-' + id);
                const countSpan = document.getElementById('fav-count');

                // Animación de salida
                card.style.transform = 'scale(0.9)';
                card.style.opacity = '0';

                setTimeout(() => {
                    card.remove();
                    // Actualizar contador visualmente
                    let current = parseInt(countSpan.innerText);
                    countSpan.innerText = Math.max(0, current - 1);

                    // Si se queda vacío (opcional, recargar página o mostrar mensaje vacío)
                    if(current - 1 === 0) {
                        location.reload(); // Para que salga el "Empty State"
                    }
                }, 300);
            }
        }
    </script>

{% endblock %}
