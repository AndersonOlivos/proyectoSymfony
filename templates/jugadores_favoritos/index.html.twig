{% extends 'base_logged.html.twig' %}
{% set current_page = 'favorites'%}

{% block title %}Mis Favoritos{% endblock %}

{% block body %}

    <div class="flex flex-col md:flex-row justify-between items-end mb-10 gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight mb-2">Mis Favoritos ❤️</h1>
            <p class="text-gray-500">Sigue de cerca a tus jugadores preferidos y no te pierdas sus estadísticas.</p>
        </div>

        <div class="bg-white px-4 py-2 rounded-xl border border-gray-200 shadow-sm text-sm font-medium text-gray-600">
            Tienes <span class="font-bold text-black" id="fav-count">{{ jugadoresFavoritosActivos|length }}</span> jugadores guardados
        </div>
    </div>

    {% if jugadoresFavoritosActivos is empty %}

        <div class="text-center py-20 bg-gray-50 rounded-[30px] border border-dashed border-gray-300">
            <div class="bg-white w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 shadow-sm">
                <svg class="w-10 h-10 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Aún no tienes favoritos</h3>
            <p class="text-gray-500 mb-6 max-w-md mx-auto">Explora el ranking mundial y añade a los jugadores que más te gusten para verlos aquí.</p>
            <a href="{{ path('app_app') }}" class="bg-black text-white px-6 py-3 rounded-xl font-bold hover:bg-gray-800 transition-colors">
                Explorar Jugadores
            </a>
        </div>

    {% else %}
        {% set jugadores = jugadoresFavoritosActivos %}
        <div id="players-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {% include 'app/_lista_jugadores.html.twig' %}
        </div>
    {% endif %}

    <script>
        function removeFavorite(id) {
            if(confirm('¿Seguro que quieres quitar a este jugador de tus favoritos?')) {
                const card = document.getElementById('card-' + id);
                const countSpan = document.getElementById('fav-count');

                // Animación de salida
                card.style.transform = 'scale(0.9)';
                card.style.opacity = '0';

                setTimeout(() => {
                    card.remove();
                    // Actualizar contador visualmente
                    let current = parseInt(countSpan.innerText);
                    countSpan.innerText = Math.max(0, current - 1);

                    // Si se queda vacío (opcional, recargar página o mostrar mensaje vacío)
                    if(current - 1 === 0) {
                        location.reload(); // Para que salga el "Empty State"
                    }
                }, 300);
            }
        }
    </script>

{% endblock %}
