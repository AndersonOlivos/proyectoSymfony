{% extends 'base_logged.html.twig' %}
{% set current_page = 'rankings'%}

{% block title %}Rankings Oficiales{% endblock %}

{% block body %}

    <div class="mb-10">
        <h1 class="text-3xl font-bold text-gray-900 tracking-tight mb-2">Rankings Oficiales 🏆</h1>
        <p class="text-gray-500">Participa en los retos y crea tus propios tops.</p>
    </div>

    <div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-10">
        <div class="relative w-full md:w-96">
            <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </span>
            <input type="text" id="searchInput" placeholder="Buscar ranking..." class="w-full py-3 pl-12 pr-4 bg-white border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-black transition-all">
        </div>

        <div class="flex bg-white p-1 rounded-xl border border-gray-200 shadow-sm">
            <button onclick="filterRankings('all')" id="btn-all" class="filter-btn px-5 py-2 bg-black text-white text-xs font-bold rounded-lg transition-all">Todos</button>
            <button onclick="filterRankings('pending')" id="btn-pending" class="filter-btn px-5 py-2 text-gray-500 hover:text-black text-xs font-medium rounded-lg transition-all">Pendientes</button>
            <button onclick="filterRankings('completed')" id="btn-completed" class="filter-btn px-5 py-2 text-gray-500 hover:text-black text-xs font-medium rounded-lg transition-all">Completados</button>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6" id="rankingsContainer">

        {% for ranking in rankings_generales %}

            {% if ranking.usuario_participa > 0 %}
                <div class="ranking-card relative flex flex-col justify-between bg-green-50/40 border-2 border-green-500 p-7 rounded-[25px] hover:shadow-lg transition-all group"
                     data-title="{{ ranking.titulo_ranking|lower }}"
                     data-status="completed">

                    <div class="flex justify-between items-start mb-4">
                        <span class="bg-white text-green-700 border border-green-200 text-[10px] font-black uppercase tracking-wider px-2 py-1 rounded">
                            {{ ranking.nombre_categoria }}
                        </span>
                        <div class="bg-green-500 text-white p-1 rounded-full">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        </div>
                    </div>

                    <div class="mb-8">
                        <h3 class="text-xl font-bold text-gray-900 mb-2 leading-tight">{{ ranking.titulo_ranking }}</h3>
                        <p class="text-sm text-gray-600">{{ ranking.descripcion_ranking }}</p>
                    </div>

                    <div class="flex items-center justify-between mt-auto border-t border-green-200 pt-4">
                        <span class="text-xs font-medium text-green-700 flex items-center gap-1">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                            {{ ranking.total_participantes }} votos
                        </span>
                        <a href="{{ path('app_ranking_personal', {'id_ranking': ranking.id_ranking}) }}">
                            <span class="text-sm font-bold text-green-700 hover:underline cursor-pointer">Ver mi Top 10 →</span>
                        </a>
                    </div>
                </div>

            {% else %}
                <div class="ranking-card relative flex flex-col justify-between bg-white border border-gray-200 p-7 rounded-[25px] hover:border-black hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group"
                     data-title="{{ ranking.titulo_ranking|lower }}"
                     data-status="pending">

                    <div class="flex justify-between items-start mb-4">
                        <span class="bg-gray-100 text-gray-500 text-[10px] font-black uppercase tracking-wider px-2 py-1 rounded group-hover:bg-black group-hover:text-white transition-colors">
                            {{ ranking.nombre_categoria }}
                        </span>
                    </div>

                    <div class="mb-8">
                        <h3 class="text-xl font-bold text-gray-900 mb-2 leading-tight group-hover:text-black transition-colors">{{ ranking.titulo_ranking }}</h3>
                        <p class="text-sm text-gray-500">{{ ranking.descripcion_ranking }}</p>
                    </div>

                    <div class="flex items-center justify-between mt-auto border-t border-gray-100 pt-4">
                        <span class="text-xs font-medium text-gray-400 flex items-center gap-1">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                            {{ ranking.total_participantes }} participan
                        </span>
                        <a href="{{ path('app_ranking_personal', {'id_ranking': ranking.id_ranking}) }}" class="bg-black text-white px-4 py-2 rounded-lg text-xs font-bold shadow-md hover:bg-gray-800 transition-colors">
                            Participar
                        </a>
                    </div>
                </div>
            {% endif %}

        {% endfor %}
    </div>

    <script>
        let currentFilter = 'all';
        let currentSearch = '';

        const searchInput = document.getElementById('searchInput');
        const cards = document.querySelectorAll('.ranking-card');
        const buttons = {
            'all': document.getElementById('btn-all'),
            'pending': document.getElementById('btn-pending'),
            'completed': document.getElementById('btn-completed')
        };

        const activeClass = ['bg-black', 'text-white', 'font-bold'];
        const inactiveClass = ['text-gray-500', 'font-medium'];

        function applyFilters() {
            cards.forEach(card => {
                const title = card.getAttribute('data-title');
                const status = card.getAttribute('data-status');

                const matchesSearch = title.includes(currentSearch);

                const matchesFilter = (currentFilter === 'all') || (currentFilter === status);

                if (matchesSearch && matchesFilter) {
                    card.style.display = 'flex'; // Usamos flex porque las tarjetas son flex
                } else {
                    card.style.display = 'none';
                }
            });
        }

        searchInput.addEventListener('input', (e) => {
            currentSearch = e.target.value.toLowerCase();
            applyFilters();
        });

        function filterRankings(filterType) {
            currentFilter = filterType;

            Object.keys(buttons).forEach(key => {
                const btn = buttons[key];
                if (key === filterType) {
                    btn.classList.add(...activeClass);
                    btn.classList.remove('text-gray-500', 'font-medium', 'hover:text-black', 'bg-gray-100');
                    btn.classList.remove('bg-gray-100'); // Por si acaso
                } else {
                    btn.classList.remove(...activeClass);
                    btn.classList.add(...inactiveClass);
                    btn.classList.add('hover:text-black');
                }
            });

            applyFilters();
        }
    </script>

{% endblock %}
