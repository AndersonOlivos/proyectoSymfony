{% extends 'base_logged.html.twig' %}
{% set current_page = 'rankings'%}

{# --- MOCK DATA: Sin imágenes, solo datos --- #}
{% set rankings = [
    {
        id: 1,
        title: 'Los Reyes del Smash 2024',
        description: 'Elige a los 10 jugadores con el remate más potente del circuito actual.',
        category: 'Potencia',
        participants: 342,
        is_completed: false
    },
    {
        id: 2,
        title: 'Muralla Defensiva',
        description: '¿Quiénes son imposibles de batir? Premia a los mejores defensores.',
        category: 'Defensa',
        participants: 128,
        is_completed: true
    },
    {
        id: 3,
        title: 'Mejores Revés del Mundo',
        description: 'Ranking exclusivo para los jugadores que dominan el lado izquierdo.',
        category: 'Posición',
        participants: 890,
        is_completed: false
    },
    {
        id: 4,
        title: 'Magia y Talento',
        description: 'Esos jugadores que hacen cosas que nadie más puede imaginar.',
        category: 'Técnica',
        participants: 560,
        is_completed: true
    }
] %}

{% block title %}Rankings Oficiales{% endblock %}

{% block body %}

    <div class="mb-10">
        <h1 class="text-3xl font-bold text-gray-900 tracking-tight mb-2">Rankings Oficiales 🏆</h1>
        <p class="text-gray-500">Participa en los retos y crea tus propios tops.</p>
    </div>

    <div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-10">
        <div class="relative w-full md:w-96">
            <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </span>
            <input type="text" placeholder="Buscar ranking..." class="w-full py-3 pl-12 pr-4 bg-white border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-black transition-all">
        </div>

        <div class="flex bg-white p-1 rounded-xl border border-gray-200 shadow-sm">
            <button class="px-5 py-2 bg-gray-100 text-black text-xs font-bold rounded-lg transition-all">Todos</button>
            <button class="px-5 py-2 text-gray-500 hover:text-black text-xs font-medium rounded-lg transition-all">Pendientes</button>
            <button class="px-5 py-2 text-gray-500 hover:text-black text-xs font-medium rounded-lg transition-all">Completados</button>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">

        {% for ranking in rankings %}

            {% if ranking.is_completed %}
                <div class="relative flex flex-col justify-between bg-green-50/40 border-2 border-green-500 p-7 rounded-[25px] hover:shadow-lg transition-all group">

                    <div class="flex justify-between items-start mb-4">
                        <span class="bg-white text-green-700 border border-green-200 text-[10px] font-black uppercase tracking-wider px-2 py-1 rounded">
                            {{ ranking.category }}
                        </span>
                        <div class="bg-green-500 text-white p-1 rounded-full">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        </div>
                    </div>

                    <div class="mb-8">
                        <h3 class="text-xl font-bold text-gray-900 mb-2 leading-tight">{{ ranking.title }}</h3>
                        <p class="text-sm text-gray-600">{{ ranking.description }}</p>
                    </div>

                    <div class="flex items-center justify-between mt-auto border-t border-green-200 pt-4">
                        <span class="text-xs font-medium text-green-700 flex items-center gap-1">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                            {{ ranking.participants }} votos
                        </span>
                        <span class="text-sm font-bold text-green-700 hover:underline cursor-pointer">Ver mi Top 10 →</span>
                    </div>
                </div>

            {% else %}
                <div class="relative flex flex-col justify-between bg-white border border-gray-200 p-7 rounded-[25px] hover:border-black hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">

                    <div class="flex justify-between items-start mb-4">
                        <span class="bg-gray-100 text-gray-500 text-[10px] font-black uppercase tracking-wider px-2 py-1 rounded group-hover:bg-black group-hover:text-white transition-colors">
                            {{ ranking.category }}
                        </span>
                    </div>

                    <div class="mb-8">
                        <h3 class="text-xl font-bold text-gray-900 mb-2 leading-tight group-hover:text-black transition-colors">{{ ranking.title }}</h3>
                        <p class="text-sm text-gray-500">{{ ranking.description }}</p>
                    </div>

                    <div class="flex items-center justify-between mt-auto border-t border-gray-100 pt-4">
                        <span class="text-xs font-medium text-gray-400 flex items-center gap-1">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                            {{ ranking.participants }} participan
                        </span>
                        <button class="bg-black text-white px-4 py-2 rounded-lg text-xs font-bold shadow-md hover:bg-gray-800 transition-colors">
                            Participar
                        </button>
                    </div>
                </div>
            {% endif %}

        {% endfor %}
    </div>

{% endblock %}
