{% extends 'base_logged.html.twig' %}

{# --- MOCK DATA PARA JAVASCRIPT --- #}
{# Pasamos estos datos a JS al final del archivo #}
{% set ranking = {
    title: 'Los Reyes del Smash 2024',
    description: 'Elige a los 10 jugadores con mayor potencia.',
    category: 'Potencia',
    total_votes: 1540
} %}

{% set global_top = [
    { name: 'Ale Galán', percent: 85 },
    { name: 'Arturo Coello', percent: 82 },
    { name: 'Juan Lebrón', percent: 75 },
    { name: 'F. Stupaczuk', percent: 60 },
    { name: 'Paquito N.', percent: 45 }
] %}

{% set candidates = [
    { id: 1, name: 'Agustín Tapia', position: 'Revés', image: 'https://ui-avatars.com/api/?name=Agustin+Tapia&background=0D8ABC&color=fff' },
    { id: 2, name: 'Momo González', position: 'Revés', image: 'https://ui-avatars.com/api/?name=Momo+Gonzalez&background=random' },
    { id: 3, name: 'Sanyo Gutiérrez', position: 'Drive', image: 'https://ui-avatars.com/api/?name=Sanyo+Gutierrez&background=random' },
    { id: 4, name: 'Fede Chingotto', position: 'Drive', image: 'https://ui-avatars.com/api/?name=Fede+Chingotto&background=random' },
    { id: 5, name: 'Mike Yanguas', position: 'Drive', image: 'https://ui-avatars.com/api/?name=Mike+Yanguas&background=random' },
    { id: 6, name: 'Alex Ruiz', position: 'Revés', image: 'https://ui-avatars.com/api/?name=Alex+Ruiz&background=random' },
    { id: 7, name: 'Juan Tello', position: 'Revés', image: 'https://ui-avatars.com/api/?name=Juan+Tello&background=random' },
    { id: 8, name: 'Fernando Belasteguín', position: 'Drive', image: 'https://ui-avatars.com/api/?name=Bela&background=random' },
    { id: 9, name: 'Coki Nieto', position: 'Revés', image: 'https://ui-avatars.com/api/?name=Coki+Nieto&background=random' },
    { id: 10, name: 'Jon Sanz', position: 'Drive', image: 'https://ui-avatars.com/api/?name=Jon+Sanz&background=random' },
    { id: 11, name: 'Javi Garrido', position: 'Revés', image: 'https://ui-avatars.com/api/?name=Javi+Garrido&background=random' },
    { id: 12, name: 'Lucas Campagnolo', position: 'Drive', image: 'https://ui-avatars.com/api/?name=Lucas+Campa&background=random' }
] %}

{% block title %}Participar - {{ ranking.title }}{% endblock %}

{% block body %}

    <div class="mb-8 border-b border-gray-100 pb-6">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <span class="bg-black text-white text-xs font-bold uppercase px-2 py-1 rounded">{{ ranking.category }}</span>
                    <span class="text-gray-400 text-xs font-semibold tracking-wide">Ranking Oficial</span>
                </div>
                <h1 class="text-3xl font-bold text-gray-900">{{ ranking.title }}</h1>
            </div>
            <div class="text-right hidden md:block">
                <p class="text-sm font-bold text-gray-900">Participantes</p>
                <p class="text-2xl font-black text-gray-900">{{ ranking.total_votes }}</p>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start pb-20">

        <div class="lg:col-span-4 order-1">
            <div class="bg-black text-white rounded-[30px] p-6 shadow-xl sticky top-6 z-30">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-xl font-bold">Tu Top 10</h2>
                    <span id="counter" class="bg-white/20 text-xs px-2 py-1 rounded font-mono">0/10</span>
                </div>

                <div id="ranking-list" class="space-y-2 mb-6">
                </div>

                <button id="btn-save" disabled class="w-full bg-white text-gray-300 py-4 rounded-2xl font-bold text-sm transition-all shadow-lg disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer hover:bg-green-500 hover:text-white">
                    Guardar Ranking
                </button>
                <p id="msg-save" class="text-[10px] text-center text-gray-500 mt-3">Selecciona 10 jugadores para guardar.</p>
            </div>
        </div>


        <div class="lg:col-span-5 space-y-6 order-2">

            <div class="relative sticky top-0 bg-gray-50 pt-2 pb-4 z-20">
                <input type="text" id="search-input" placeholder="Buscar candidato..."
                       class="w-full py-4 pl-12 pr-4 bg-white border-2 border-transparent focus:border-black rounded-2xl shadow-sm text-sm font-medium transition-all outline-none">
                <svg class="w-5 h-5 text-gray-400 absolute left-4 top-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>

            <div class="flex justify-between items-center px-1">
                <h3 class="font-bold text-gray-900 text-sm uppercase tracking-wider">Disponibles</h3>
                <span class="text-xs text-gray-400">Clic en + para añadir</span>
            </div>

            <div id="candidates-list" class="space-y-3 pb-10">
            </div>
        </div>


        <div class="lg:col-span-3 order-3">
            <div class="bg-white rounded-[25px] p-6 shadow-sm border border-gray-100 sticky top-6">
                <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2 text-sm">
                    <svg class="w-5 h-5 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                    Lo más votado
                </h3>

                <div class="space-y-4">
                    {% for player in global_top %}
                        <div class="relative">
                            <div class="flex items-center justify-between text-[11px] font-bold mb-1 z-10 relative">
                                <span class="text-gray-800">{{ loop.index }}. {{ player.name }}</span>
                                <span class="text-gray-400">{{ player.percent }}%</span>
                            </div>
                            <div class="h-1.5 w-full bg-gray-100 rounded-full overflow-hidden">
                                <div class="h-full bg-black rounded-full" style="width: {{ player.percent }}%"></div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

    </div>

    {# --- SCRIPT PARA LA LÓGICA DE INTERACCIÓN --- #}
    <script>
        // 1. Datos iniciales (Traídos de Twig)
        const allCandidates = {{ candidates|json_encode|raw }};
        let selectedPlayers = []; // Aquí guardaremos los IDs seleccionados
        const maxSlots = 10;

        // Referencias al DOM
        const candidatesContainer = document.getElementById('candidates-list');
        const rankingContainer = document.getElementById('ranking-list');
        const counterLabel = document.getElementById('counter');
        const saveBtn = document.getElementById('btn-save');
        const msgSave = document.getElementById('msg-save');
        const searchInput = document.getElementById('search-input');

        // 2. Función para pintar la lista de Candidatos (Centro)
        function renderCandidates(filterText = '') {
            candidatesContainer.innerHTML = ''; // Limpiar

            // Filtrar: Que no estén seleccionados Y que coincidan con la búsqueda
            const available = allCandidates.filter(p =>
                !selectedPlayers.find(s => s.id === p.id) &&
                p.name.toLowerCase().includes(filterText.toLowerCase())
            );

            if (available.length === 0) {
                candidatesContainer.innerHTML = `<div class="text-center text-gray-400 text-sm py-4">No hay jugadores disponibles</div>`;
                return;
            }

            available.forEach(player => {
                const el = document.createElement('div');
                el.className = 'bg-white p-3 rounded-2xl flex items-center justify-between border border-gray-100 hover:border-black hover:shadow-md transition-all group cursor-pointer';
                el.onclick = () => addPlayer(player.id); // Al hacer clic, añadir

                el.innerHTML = `
                    <div class="flex items-center gap-3">
                        <img src="${player.image}" class="w-10 h-10 rounded-xl object-cover bg-gray-200">
                        <div>
                            <p class="font-bold text-gray-900 text-sm">${player.name}</p>
                            <p class="text-[10px] text-gray-500 uppercase">${player.position}</p>
                        </div>
                    </div>
                    <button class="bg-gray-100 group-hover:bg-black group-hover:text-white text-black p-2 rounded-lg transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    </button>
                `;
                candidatesContainer.appendChild(el);
            });
        }

        // 3. Función para pintar el Ranking (Izquierda)
        function renderRanking() {
            rankingContainer.innerHTML = '';

            // Pintar los 10 huecos
            for (let i = 0; i < maxSlots; i++) {
                const player = selectedPlayers[i];
                const position = i + 1;
                const div = document.createElement('div');

                if (player) {
                    // SLOT OCUPADO
                    div.className = 'flex items-center gap-2 bg-white/10 p-2 rounded-xl border border-white/10 group animate-fade-in-left select-none';
                    div.innerHTML = `
                        <span class="font-black text-yellow-400 text-lg w-6 text-center shrink-0">${position}</span>
                        <img src="${player.image}" class="w-8 h-8 rounded-full border border-white/30 shrink-0">
                        <span class="text-sm font-bold flex-1 truncate text-white">${player.name}</span>

                        <div class="flex items-center gap-1">
                            ${i > 0 ? `<button onclick="movePlayer(${i}, -1)" class="p-1 hover:bg-white/20 rounded text-gray-400 hover:text-white" title="Subir">↑</button>` : '<span class="w-5"></span>'}
                            ${i < selectedPlayers.length - 1 ? `<button onclick="movePlayer(${i}, 1)" class="p-1 hover:bg-white/20 rounded text-gray-400 hover:text-white" title="Bajar">↓</button>` : '<span class="w-5"></span>'}
                            <button onclick="removePlayer(${i})" class="p-1 hover:bg-red-500/20 rounded text-gray-400 hover:text-red-400 ml-1" title="Quitar">✕</button>
                        </div>
                    `;
                } else {
                    // SLOT VACÍO
                    div.className = 'flex items-center gap-3 p-2 rounded-xl border border-dashed border-white/10 text-gray-600';
                    div.innerHTML = `
                        <span class="font-bold text-gray-700 text-lg w-6 text-center">${position}</span>
                        <span class="text-xs italic">Vacío</span>
                    `;
                }
                rankingContainer.appendChild(div);
            }

            // Actualizar contador y botón
            counterLabel.innerText = `${selectedPlayers.length}/${maxSlots}`;

            if (selectedPlayers.length === maxSlots) {
                saveBtn.disabled = false;
                saveBtn.classList.remove('text-gray-300');
                saveBtn.classList.add('text-black');
                saveBtn.innerText = "¡Guardar Ranking!";
                msgSave.innerText = "Ranking completo. Listo para enviar.";
                msgSave.classList.add('text-green-500');
            } else {
                saveBtn.disabled = true;
                saveBtn.classList.add('text-gray-300');
                saveBtn.innerText = "Guardar Ranking";
                msgSave.innerText = `Te faltan ${maxSlots - selectedPlayers.length} jugadores.`;
                msgSave.classList.remove('text-green-500');
            }
        }

        // 4. Lógica de Interacción

        // Añadir jugador
        window.addPlayer = (id) => {
            if (selectedPlayers.length >= maxSlots) {
                alert("¡Ya tienes 10 jugadores! Quita uno antes de añadir otro.");
                return;
            }
            const player = allCandidates.find(p => p.id === id);
            if (player) {
                selectedPlayers.push(player);
                updateUI();
            }
        };

        // Quitar jugador
        window.removePlayer = (index) => {
            selectedPlayers.splice(index, 1);
            updateUI();
        };

        // Mover (Subir o Bajar)
        window.movePlayer = (index, direction) => {
            // direction: -1 (subir), 1 (bajar)
            const newIndex = index + direction;
            if (newIndex >= 0 && newIndex < selectedPlayers.length) {
                // Intercambiar elementos
                [selectedPlayers[index], selectedPlayers[newIndex]] = [selectedPlayers[newIndex], selectedPlayers[index]];
                updateUI();
            }
        };

        // Helper para actualizar todo
        function updateUI() {
            renderCandidates(searchInput.value);
            renderRanking();
        }

        // Evento Buscador
        searchInput.addEventListener('input', (e) => {
            renderCandidates(e.target.value);
        });

        // Inicializar
        updateUI();

    </script>

{% endblock %}
