{% extends 'base_admin.html.twig' %}

{% block title %}{{ titulo }}{% endblock %}
{% block header_title %}{{ titulo }}{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto">

        <a href="{{ path('admin_categoria_index') }}" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-900 mb-6 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Volver al listado
        </a>

        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
            {{ form_start(form) }}

            <div class="mb-6">
                {{ form_row(form.nombre) }}
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
                <a href="{{ path('admin_categoria_index') }}" class="px-4 py-2 rounded-lg text-gray-600 hover:bg-gray-100 font-medium transition-colors">
                    Cancelar
                </a>
                <button type="submit" class="px-6 py-2 rounded-lg bg-yellow-400 hover:bg-yellow-500 text-black font-bold shadow-lg shadow-yellow-500/20 transition-all">
                    {{ categoria.id ? 'Actualizar' : 'Guardar Categoría' }}
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
