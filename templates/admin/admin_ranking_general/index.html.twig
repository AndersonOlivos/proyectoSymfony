{% extends 'admin/base_admin.html.twig' %}

{% set current_page = 'ranking_general' %}

{% block title %}Rankings Generales{% endblock %}
{% block header_title %}Gestión de Rankings{% endblock %}

{% block body %}

    <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">
        <div class="w-full md:w-1/3 relative">
            <input type="text" id="buscadorRankings" placeholder="Buscar ranking..."
                   class="w-full pl-10 pr-4 py-2 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
            <svg class="w-5 h-5 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
        </div>

        <button onclick="abrirModalNueva()"
                class="bg-black text-white px-4 py-2 rounded-lg hover:bg-gray-800 transition-colors flex items-center gap-2 font-medium text-sm shadow-md">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Nuevo Ranking
        </button>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <table class="w-full text-left text-sm text-gray-600">
            <thead class="bg-gray-50 text-gray-900 font-semibold uppercase tracking-wider text-xs border-b border-gray-100">
            <tr>
                <th class="px-6 py-4">Título</th>
                <th class="px-6 py-4">Descripción</th>
                <th class="px-6 py-4">Categoría Asignada</th>
                <th class="px-6 py-4 text-center">Estado</th>
                <th class="px-6 py-4 text-right">Acciones</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-gray-100" id="tablaRankingsBody">
            {% for ranking in rankings %}
                <tr class="group hover:bg-gray-50 transition-colors fila-ranking" data-titulo="{{ ranking.titulo|lower }}">

                    <td class="px-6 py-4 font-bold text-gray-900 text-base">
                        {{ ranking.titulo | upper }}
                    </td>

                    <td class="px-6 py-4 text-gray-500 max-w-xs truncate">
                        {{ ranking.descripcion }}
                    </td>

                    <td class="px-6 py-4">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100">
                            {{ ranking.categoria_nombre | upper }}
                        </span>
                    </td>

                    <td class="px-6 py-4 text-center">
                        {% if ranking.activo == 1 %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                Activo
                            </span>
                        {% else %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500">
                                Inactivo
                            </span>
                        {% endif %}
                    </td>

                    <td class="px-6 py-4 text-right flex justify-end gap-2 opacity-60 group-hover:opacity-100 transition-opacity">
                        <button
                            onclick="abrirModalEditar(this)"
                            data-id="{{ ranking.id }}"
                            data-titulo="{{ ranking.titulo }}"
                            data-descripcion="{{ ranking.descripcion }}"
                            data-categoria-id="{{ ranking.categoria_id }}"
                            data-activo="{{ ranking.activo ? 1 : 0 }}"
                            class="text-blue-600 hover:bg-blue-50 p-2 rounded-lg transition-colors"
                            title="Editar"
                        >
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                        </button>
                        <button
                            class="text-red-500 hover:bg-red-50 p-2 rounded-lg transition-colors"
                            title="Eliminar"
                            onclick="confirmarEliminar('{{ ranking.id }}', '{{ ranking.titulo }}')"
                        >
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                        </button>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div id="rankingModal" class="hidden fixed inset-0 z-50 w-full h-full bg-gray-900 bg-opacity-50 flex items-center justify-center transition-opacity duration-300">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg mx-4 overflow-hidden transform transition-all">

            <div class="bg-gray-50 px-4 py-3 sm:px-6 flex justify-between items-center border-b border-gray-100">
                <h3 class="text-lg leading-6 font-bold text-gray-900" id="modal-title">Nuevo Ranking</h3>
                <button type="button" onclick="toggleModal('rankingModal')" class="text-gray-400 hover:text-gray-500 hover:bg-gray-100 rounded-full p-1 transition-colors">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <form action="{{ path('admin_ranking_new') }}" method="POST" id="formRanking">
                <div class="p-6 space-y-6">

                    <div>
                        <label for="titulo" class="block text-sm font-medium text-gray-700">Título del Ranking</label>
                        <input type="text" name="titulo" id="titulo" required
                               class="mt-1 block w-full border border-gray-200 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                               placeholder="Ej: Ranking de Otoño">
                    </div>

                    <div>
                        <label for="descripcion" class="block text-sm font-medium text-gray-700">Descripción</label>
                        <textarea name="descripcion" id="descripcion" rows="3"
                                  class="mt-1 block w-full border border-gray-200 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                  placeholder="Detalles sobre este ranking..."></textarea>
                    </div>

                    <div>
                        <label for="categoria" class="block text-sm font-medium text-gray-700">Categoría Asociada</label>
                        <select name="categoria" id="categoria" required
                                class="mt-1 block w-full border border-gray-200 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm bg-white">
                            <option value="" disabled selected>Selecciona una categoría</option>
                            {% for cat in categorias %}
                                <option value="{{ cat.id }}">{{ cat.nombre }}</option>
                            {% endfor %}
                        </select>
                        <p class="mt-1 text-xs text-gray-500">El ranking debe pertenecer a una única categoría.</p>
                    </div>

                    <div class="flex items-center bg-gray-50 p-3 rounded-lg border border-gray-100">
                        <input type="hidden" name="activo" value="0">
                        <input id="activo" name="activo" value="1" type="checkbox" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" checked>
                        <label for="activo" class="ml-2 block text-sm text-gray-900 font-medium">
                            Ranking Activo
                        </label>
                    </div>

                </div>

                <div class="bg-gray-50 px-4 py-3 sm:px-6 flex flex-col-reverse sm:flex-row sm:justify-end gap-2 border-t border-gray-100">
                    <button type="button" onclick="toggleModal('rankingModal')" class="w-full sm:w-auto inline-flex justify-center rounded-lg border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none sm:text-sm transition-colors">
                        Cancelar
                    </button>
                    <button type="submit" class="w-full sm:w-auto inline-flex justify-center rounded-lg border border-transparent shadow-sm px-4 py-2 bg-blue-600 text-base font-medium text-white hover:bg-blue-700 focus:outline-none sm:text-sm transition-colors">
                        Guardar Ranking
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div id="deleteModal" class="hidden fixed inset-0 z-50 w-full h-full bg-gray-900 bg-opacity-50 flex items-center justify-center transition-opacity duration-300">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm mx-4 overflow-hidden transform transition-all p-6 text-center">
            <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-red-100 mb-4">
                <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            </div>
            <h3 class="text-lg leading-6 font-bold text-gray-900 mb-2">¿Eliminar Ranking?</h3>
            <p class="text-sm text-gray-500 mb-6">
                Vas a eliminar el ranking <span id="nombreRankingEliminar" class="font-bold text-gray-800"></span>.
                Esta acción no se puede deshacer.
            </p>
            <div class="flex justify-center gap-3">
                <button type="button" onclick="toggleModal('deleteModal')" class="px-4 py-2 bg-white text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 font-medium text-sm transition-colors">Cancelar</button>
                <form id="formEliminar" method="POST" action="">
                    <button type="submit" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 font-medium text-sm shadow-sm transition-colors">Sí, Eliminar</button>
                </form>
            </div>
        </div>
    </div>

    <script>
        const urlNueva = "{{ path('admin_ranking_new') }}";
        const urlEditarBase = "{{ path('admin_ranking_edit', {'id': 0}) }}";
        const urlEliminarBase = "{{ path('admin_ranking_delete', {'id': 0}) }}";

        function toggleModal(modalID) {
            const modal = document.getElementById(modalID);
            const body = document.body;
            if (modal.classList.contains('hidden')) {
                modal.classList.remove('hidden');
                body.style.overflow = 'hidden';
            } else {
                modal.classList.add('hidden');
                body.style.overflow = 'auto';
            }
        }

        function abrirModalNueva() {
            document.getElementById('titulo').value = '';
            document.getElementById('descripcion').value = '';
            document.getElementById('categoria').value = ''; // Reset select
            document.getElementById('activo').checked = true;
            document.getElementById('modal-title').innerText = "Nuevo Ranking";

            const form = document.getElementById('formRanking');
            form.action = urlNueva;

            toggleModal('rankingModal');
        }

        function abrirModalEditar(boton) {
            const id = boton.dataset.id;
            const titulo = boton.dataset.titulo;
            const descripcion = boton.dataset.descripcion;
            const categoriaId = boton.dataset.categoriaId;
            const activo = boton.dataset.activo;

            document.getElementById('titulo').value = titulo;
            document.getElementById('descripcion').value = descripcion;
            document.getElementById('activo').checked = (activo === "1");
            document.getElementById('categoria').value = categoriaId;
            document.getElementById('modal-title').innerText = "Editar Ranking";

            const form = document.getElementById('formRanking');
            form.action = urlEditarBase.replace('0', id);

            toggleModal('rankingModal');
        }

        function confirmarEliminar(id, titulo) {
            document.getElementById('nombreRankingEliminar').innerText = titulo;
            const form = document.getElementById('formEliminar');
            form.action = urlEliminarBase.replace('0', id);
            toggleModal('deleteModal');
        }

        document.addEventListener('DOMContentLoaded', function() {
            const inputRanking = document.getElementById('buscadorRankings');
            const filasRanking = document.querySelectorAll('.fila-ranking');

            if(inputRanking) {
                inputRanking.addEventListener('input', function(e) {
                    const texto = e.target.value.toLowerCase();
                    filasRanking.forEach(fila => {
                        const titulo = fila.getAttribute('data-titulo');
                        // Mostramos si coincide
                        fila.style.display = titulo.includes(texto) ? 'table-row' : 'none';
                    });
                });
            }
        });
    </script>
{% endblock %}
