{# templates/base_admin.html.twig #}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin Panel{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="{{ asset('/images/logoPadelRank.png') }}">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-gray-100 h-screen w-screen flex items-center justify-center p-4 lg:p-6 overflow-hidden">

<div class="bg-white w-full h-full max-w-[1600px] rounded-[40px] shadow-2xl flex overflow-hidden relative">

    <aside class="w-24 h-full flex flex-col items-center py-8 border-r border-gray-100 z-20 bg-white">

        <div class="mb-12">
            <a href="#" class="flex flex-col items-center text-2xl font-bold text-gray-900 tracking-tighter leading-none group">
                <span class="text-yellow-500">Admin</span>
                <span class="text-gray-400 group-hover:text-black transition-colors text-sm">Panel</span>
            </a>
        </div>

        <nav class="flex-1 flex flex-col gap-8 w-full px-4">
            {% set current_page = current_page|default('') %}

            <a href="{{ path('admin_dashboard') }}"
               class="group relative flex items-center justify-center w-full h-12 rounded-xl transition-all duration-300
               {{ current_page == 'dashboard' ? 'bg-black text-white shadow-lg shadow-gray-300' : 'text-gray-400 hover:text-white hover:bg-black' }}">

                <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6.025A7.5 7.5 0 1 0 17.975 14H10V6.025Z"/>
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 3c-.169 0-.334.014-.5.025V11h7.975c.011-.166.025-.331.025-.5A7.5 7.5 0 0 0 13.5 3Z"/>
                </svg>
                <span class="absolute left-14 bg-gray-900 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap z-50 pointer-events-none">
                    Estadística
                </span>
            </a>

            <a href="{{ path('admin_ranking_general_index') }}"
               class="group relative flex items-center justify-center w-full h-12 rounded-xl transition-all duration-300
               {{ current_page == 'ranking_general' ? 'bg-black text-white shadow-lg shadow-gray-300' : 'text-gray-400 hover:text-white hover:bg-black' }}">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 0 1-.982-3.172M9.497 14.25a7.454 7.454 0 0 0 .981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 0 0 7.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 0 0 2.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 0 1 2.916.52 6.003 6.003 0 0 1-5.395 4.972m0 0a6.726 6.726 0 0 1-2.749 1.35m0 0a6.772 6.772 0 0 1-3.044 0" />
                </svg>
                <span class="absolute left-14 bg-gray-900 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap z-50 pointer-events-none">
                    Ranking General
                </span>
            </a>

            <a href="{{ path('admin_categoria_index') }}"
               class="group relative flex items-center justify-center w-full h-12 rounded-xl transition-all duration-300
               {{ current_page == 'categorias' ? 'bg-black text-white shadow-lg shadow-gray-300' : 'text-gray-400 hover:text-white hover:bg-black' }}">

                <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.2 6H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h11.2a1 1 0 0 0 .747-.334l4.46-5a1 1 0 0 0 0-1.332l-4.46-5A1 1 0 0 0 15.2 6Z"/>
                </svg>
                <span class="absolute left-14 bg-gray-900 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap z-50 pointer-events-none">
                    Categorias
                </span>
            </a>

            <a href="{{ path('admin_jugador_index') }}"
               class="group relative flex items-center justify-center w-full h-12 rounded-xl transition-all duration-300
               {{ current_page == 'jugadores' ? 'bg-black text-white shadow-lg shadow-gray-300' : 'text-gray-400 hover:text-white hover:bg-black' }}">

                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
                <span class="absolute left-14 bg-gray-900 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap z-50 pointer-events-none">
                    Jugadores
                </span>
            </a>

            <a href="{{ path('admin_usuarios_index') }}"
               class="group relative flex items-center justify-center w-full h-12 rounded-xl transition-all duration-300
               {{ current_page == 'usuarios' ? 'bg-black text-white shadow-lg shadow-gray-300' : 'text-gray-400 hover:text-white hover:bg-black' }}">

                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                </svg>

                <span class="absolute left-14 bg-gray-900 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap z-50 pointer-events-none">
                    Usuarios
                </span>
            </a>

            <div class="h-px w-full bg-gray-100 my-2"></div>

            <a href="{{ path('app_app') }}"
               class="group relative flex items-center justify-center w-full h-12 rounded-xl text-gray-400 hover:text-blue-500 hover:bg-blue-50 transition-all duration-300">

                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                <span class="absolute left-14 bg-gray-900 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap z-50 pointer-events-none">
                    Ir a Web
                </span>
            </a>

        </nav>

        <div class="flex flex-col gap-4 w-full px-4">
            <a href="{{ path('app_logout') }}" class="group relative flex items-center justify-center w-full h-12 rounded-xl text-gray-400 hover:text-red-500 hover:bg-red-50 transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
                <span class="absolute left-14 bg-gray-900 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap z-50 pointer-events-none">Salir</span>
            </a>
        </div>
    </aside>

    <main class="flex-1 flex flex-col bg-gray-50/50 h-full relative overflow-hidden">

        <header class="w-full h-24 flex items-center justify-between px-10 py-6 shrink-0 z-10">

            <div class="flex-1 max-w-xl">
                <h1 class="text-2xl font-bold text-gray-800">{% block header_title %}Dashboard{% endblock %}</h1>
            </div>

            <div class="flex items-center gap-4 ml-4">
                <div class="flex items-center gap-3 pl-4 border-l border-gray-200">
                    <div class="text-right hidden md:block">
                        <p class="text-sm font-semibold text-gray-900">{{ app.user.username }}</p>
                        <p class="text-xs text-yellow-600 font-bold bg-yellow-100 px-2 py-0.5 rounded-full inline-block">
                            ADMINISTRADOR
                        </p>
                    </div>
                    <div class="h-10 w-10 rounded-full bg-gray-900 text-white flex items-center justify-center overflow-hidden border-2 border-white shadow-sm font-bold">
                        A
                    </div>
                </div>
            </div>
        </header>

        <div class="flex-1 overflow-y-auto no-scrollbar p-10 pt-4">

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-6 px-4 py-3 rounded-xl border flex items-center gap-3 shadow-sm
                        {{ label == 'success' ? 'bg-green-100 border-green-200 text-green-800' : 'bg-red-100 border-red-200 text-red-800' }}">
                        <p class="font-medium text-sm">{{ message }}</p>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </div>

    </main>
</div>
</body>
</html>
