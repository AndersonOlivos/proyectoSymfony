{% extends 'admin/base_admin.html.twig' %}

{% block title %}Categorías{% endblock %}
{% block header_title %}Gestión de Categorías{% endblock %}

{% block body %}
    <div class="flex justify-between items-center mb-6">
        <p class="text-gray-500">Administra las divisiones o categorías del ranking.</p>
        <a href="{{ path('admin_categoria_new') }}" class="bg-black text-white px-4 py-2 rounded-lg hover:bg-gray-800 transition-colors flex items-center gap-2 font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Nueva Categoría
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <table class="w-full text-left text-sm text-gray-600">
            <thead class="bg-gray-50 text-gray-900 font-semibold uppercase tracking-wider text-xs border-b border-gray-100">
            <tr>
                <th class="px-6 py-4">Nombre</th>
                <th class="px-6 py-4 text-right">Acciones</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
            {% for categoria in categorias %}
                <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4 font-medium text-gray-900 text-base">{{ categoria.nombre }}</td>
                    <td class="px-6 py-4 text-right flex justify-end gap-2">

                        {# Botón Editar #}
                        <a href="{{ path('admin_categoria_edit', {'id': categoria.id}) }}" class="text-blue-600 hover:bg-blue-50 p-2 rounded-lg transition-colors" title="Editar">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                            </svg>
                        </a>

                        {# Botón Eliminar (Formulario Oculto) #}
                        <form method="post" action="{{ path('admin_categoria_delete', {'id': categoria.id}) }}" onsubmit="return confirm('¿Seguro que quieres borrar esta categoría?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ categoria.id) }}">
                            <button class="text-red-500 hover:bg-red-50 p-2 rounded-lg transition-colors" title="Eliminar">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </form>

                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="px-6 py-12 text-center text-gray-400">
                        No hay categorías creadas todavía.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
