{% extends 'admin/base_admin.html.twig' %}

{% set current_page = 'categorias' %}

{% block title %}Categorías{% endblock %}
{% block header_title %}Gestión de Categorías{% endblock %}

{% block body %}
    {# --- DATOS FALSOS PARA SIMULACIÓN (Esto en el futuro vendrá del Controller) --- #}
    {% set fake_categorias = [
        {'id': 1, 'nombre': 'Primera Categoría', 'active': true, 'jugadores': 12},
        {'id': 2, 'nombre': 'Segunda Categoría', 'active': true, 'jugadores': 24},
        {'id': 3, 'nombre': 'Tercera Categoría', 'active': false, 'jugadores': 8},
        {'id': 4, 'nombre': 'Veteranos', 'active': true, 'jugadores': 15},
    ] %}

    {% set fake_jugadores = [
        {'id': 101, 'nombre': 'Alejandro Galán', 'ranking': 1},
        {'id': 102, 'nombre': 'Juan Lebrón', 'ranking': 2},
        {'id': 103, 'nombre': 'Agustín Tapia', 'ranking': 3},
        {'id': 104, 'nombre': 'Arturo Coello', 'ranking': 4},
        {'id': 105, 'nombre': 'Paquito Navarro', 'ranking': 5},
        {'id': 106, 'nombre': 'Fede Chingotto', 'ranking': 6},
    ] %}

    <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">

        <div class="w-full md:w-1/3 relative">
            <input type="text" placeholder="Buscar categoría..."
                   class="w-full pl-10 pr-4 py-2 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
            <svg class="w-5 h-5 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
        </div>

        <button onclick="toggleModal('categoriaModal')"
                class="bg-black text-white px-4 py-2 rounded-lg hover:bg-gray-800 transition-colors flex items-center gap-2 font-medium text-sm shadow-md">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Nueva Categoría
        </button>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <table class="w-full text-left text-sm text-gray-600">
            <thead class="bg-gray-50 text-gray-900 font-semibold uppercase tracking-wider text-xs border-b border-gray-100">
            <tr>
                <th class="px-6 py-4">Nombre</th>
                <th class="px-6 py-4 text-center">Estado</th>
                <th class="px-6 py-4 text-center">Jugadores Asignados</th>
                <th class="px-6 py-4 text-right">Acciones</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
            {% for cat in fake_categorias %}
                <tr class="group hover:bg-gray-50 transition-colors">

                    <td class="px-6 py-4 font-bold text-gray-900 text-base">
                        {{ cat.nombre }}
                    </td>

                    <td class="px-6 py-4 text-center">
                        {% if cat.active %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                Activa
                            </span>
                        {% else %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500">
                                Inactiva
                            </span>
                        {% endif %}
                    </td>

                    <td class="px-6 py-4 text-center">
                        <span class="bg-blue-50 text-blue-700 px-2 py-1 rounded text-xs font-bold">
                            {{ cat.jugadores }} jugadores
                        </span>
                    </td>

                    <td class="px-6 py-4 text-right flex justify-end gap-2 opacity-60 group-hover:opacity-100 transition-opacity">
                        <button onclick="toggleModal('categoriaModal')" class="text-blue-600 hover:bg-blue-50 p-2 rounded-lg transition-colors" title="Editar">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                        </button>
                        <button class="text-red-500 hover:bg-red-50 p-2 rounded-lg transition-colors" title="Desactivar/Eliminar">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                        </button>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div id="categoriaModal" class="hidden fixed inset-0 z-50 w-full h-full bg-gray-900 bg-opacity-50 flex items-center justify-center transition-opacity duration-300">

        <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg mx-4 overflow-hidden transform transition-all">

            <div class="bg-gray-50 px-4 py-3 sm:px-6 flex justify-between items-center border-b border-gray-100">
                <h3 class="text-lg leading-6 font-bold text-gray-900">Nueva Categoría</h3>
                <button type="button" onclick="toggleModal('categoriaModal')" class="text-gray-400 hover:text-gray-500 hover:bg-gray-100 rounded-full p-1 transition-colors">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <form>
                <div class="p-6 space-y-6">

                    <div>
                        <label for="nombre" class="block text-sm font-medium text-gray-700">Nombre de la Categoría</label>
                        <input type="text" name="nombre" id="nombre" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm" placeholder="Ej: Primera División">
                    </div>

                    <div class="flex items-center bg-gray-50 p-3 rounded-lg border border-gray-100">
                        <input id="activo" name="activo" type="checkbox" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" checked>
                        <label for="activo" class="ml-2 block text-sm text-gray-900 font-medium">
                            Categoría Activa
                        </label>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Asignar Jugadores</label>

                        <div class="relative mb-3">
                            <input type="text" placeholder="Buscar jugador..." class="w-full pl-9 pr-3 py-2 border border-gray-200 rounded text-sm focus:outline-none focus:border-blue-500 transition-colors">
                            <svg class="w-4 h-4 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        </div>

                        <div class="h-48 overflow-y-auto border border-gray-200 rounded-lg bg-gray-50">
                            <ul class="divide-y divide-gray-200">
                                {% for jugador in fake_jugadores %}
                                    <li class="flex items-center px-4 py-2 hover:bg-white transition-colors">
                                        <input id="jugador_{{ jugador.id }}" name="jugadores[]" value="{{ jugador.id }}" type="checkbox" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded cursor-pointer">
                                        <label for="jugador_{{ jugador.id }}" class="ml-3 flex-1 flex justify-between cursor-pointer select-none">
                                            <span class="text-sm font-medium text-gray-900">{{ jugador.nombre }}</span>
                                            <span class="text-xs text-gray-500 border border-gray-200 bg-white px-2 py-0.5 rounded">#{{ jugador.ranking }}</span>
                                        </label>
                                    </li>
                                {% endfor %}
                                <li class="px-4 py-3 text-xs text-center text-gray-400">... cargando más jugadores ...</li>
                            </ul>
                        </div>

                        <div class="flex justify-between items-center mt-2 text-xs text-gray-500">
                            <span>1-6 de 50 jugadores</span>
                            <div class="flex gap-1">
                                <button type="button" class="px-2 py-1 bg-white border border-gray-200 rounded hover:bg-gray-50 disabled:opacity-50" disabled>&lt;</button>
                                <button type="button" class="px-2 py-1 bg-white border border-gray-200 rounded hover:bg-gray-50">&gt;</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-gray-50 px-4 py-3 sm:px-6 flex flex-col-reverse sm:flex-row sm:justify-end gap-2 border-t border-gray-100">
                    <button type="button" onclick="toggleModal('categoriaModal')" class="w-full sm:w-auto inline-flex justify-center rounded-lg border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none sm:text-sm transition-colors">
                        Cancelar
                    </button>
                    <button type="button" class="w-full sm:w-auto inline-flex justify-center rounded-lg border border-transparent shadow-sm px-4 py-2 bg-blue-600 text-base font-medium text-white hover:bg-blue-700 focus:outline-none sm:text-sm transition-colors">
                        Guardar Categoría
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function toggleModal(modalID) {
            const modal = document.getElementById(modalID);
            // Simplemente alternamos 'hidden' y 'flex'.
            // Al quitar 'hidden', la clase 'flex' (que ya está en el HTML) entra en acción y centra todo.
            if (modal.classList.contains('hidden')) {
                modal.classList.remove('hidden');
                // Opcional: Bloquear el scroll del body cuando el modal está abierto
                document.body.style.overflow = 'hidden';
            } else {
                modal.classList.add('hidden');
                // Restaurar scroll
                document.body.style.overflow = 'auto';
            }
        }
    </script>
{% endblock %}
