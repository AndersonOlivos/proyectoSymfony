{% extends 'admin/base_admin.html.twig' %}

{% set current_page = 'jugadores' %}

{% block title %}Jugadores{% endblock %}
{% block header_title %}Gestión de Jugadores{% endblock %}

{% block body %}
    <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">

        <form class="w-full md:w-1/2 relative">
            <input type="text"
                   name="q"
                   value="{{ app.request.query.get('q') }}"
                   placeholder="Buscar jugador por nombre, email..."
                   class="w-full pl-10 pr-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm shadow-sm transition-all">

            <svg class="w-5 h-5 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
        </form>

        <a href="{{ path('admin_jugador_new') }}" class="bg-black text-white px-5 py-2.5 rounded-lg hover:bg-gray-800 transition-colors flex items-center gap-2 font-medium text-sm shadow-md hover:shadow-lg transform active:scale-95 duration-150">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
            </svg>
            Nuevo Jugador
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <table class="w-full text-left text-sm text-gray-600">
            <thead class="bg-gray-50 text-gray-900 font-semibold uppercase tracking-wider text-xs border-b border-gray-100">
            <tr>
                <th class="px-6 py-4">Perfil</th>
                <th class="px-6 py-4">Contacto</th>
                <th class="px-6 py-4 text-center">Estado</th>
                <th class="px-6 py-4 text-right">Acciones</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">

            {# BUCLE PRINCIPAL: Aquí iterarás sobre la variable 'jugadores' que pases desde el controlador #}
            {% for jugador in jugadores %}
                <tr class="group hover:bg-gray-50 transition-colors">

                    <td class="px-6 py-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-50 to-blue-100 border border-blue-200 flex items-center justify-center text-blue-600 font-bold shadow-sm">
                                {{ jugador.nombre|slice(0,2)|upper }}
                            </div>
                            <div>
                                <p class="font-bold text-gray-900">{{ jugador.nombre }}</p>
                                <p class="text-xs text-gray-400">ID: #{{ jugador.id }}</p>
                            </div>
                        </div>
                    </td>

                    <td class="px-6 py-4">
                        <div class="flex flex-col gap-1">
                            <div class="flex items-center gap-2 text-gray-500">
                                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                                <span class="text-xs">{{ jugador.telefono|default('Sin teléfono') }}</span>
                            </div>
                        </div>
                    </td>

                    <td class="px-6 py-4 text-center">
                        {% if jugador.activo %}
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-green-50 text-green-700 border border-green-100">
                                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                                    Activo
                                </span>
                        {% else %}
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-500 border border-gray-200">
                                    <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>
                                    Inactivo
                                </span>
                        {% endif %}
                    </td>

                    <td class="px-6 py-4 text-right">
                        <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">

                            {# Botón Editar #}
                            <a href="{{ path('admin_jugador_edit', {'id': jugador.id}) }}" class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg transition-colors" title="Editar datos">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                            </a>

                            {# Botón Toggle Estado (Formulario POST) #}
                            <form method="post" action="{{ path('admin_jugador_toggle', {'id': jugador.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ jugador.id) }}">

                                {% if jugador.activo %}
                                    <button class="p-2 text-red-500 hover:bg-red-50 rounded-lg transition-colors" title="Desactivar jugador">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                                        </svg>
                                    </button>
                                {% else %}
                                    <button class="p-2 text-green-500 hover:bg-green-50 rounded-lg transition-colors" title="Reactivar jugador">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                        </svg>
                                    </button>
                                {% endif %}
                            </form>

                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="px-6 py-16 text-center">
                        <div class="flex flex-col items-center justify-center text-gray-400">
                            <svg class="w-12 h-12 mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                            <p class="text-base font-medium">No se encontraron jugadores</p>
                            <p class="text-sm">Prueba a cambiar el filtro de búsqueda o crea uno nuevo.</p>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {% if maxPaginas is defined and maxPaginas > 1 %}
            <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between bg-gray-50">
                <p class="text-xs text-gray-500">
                    Mostrando página <span class="font-bold text-gray-800">{{ paginaActual }}</span> de <span class="font-bold text-gray-800">{{ maxPaginas }}</span>
                </p>

                <div class="flex gap-2">
                    {% if paginaActual > 1 %}
                        <a href="{{ path('admin_jugador_index', app.request.query.all|merge({'page': paginaActual - 1})) }}" class="px-3 py-1 bg-white border border-gray-200 rounded text-sm text-gray-600 hover:bg-gray-100 hover:text-gray-900 transition-colors">
                            &larr; Anterior
                        </a>
                    {% else %}
                        <span class="px-3 py-1 bg-gray-50 border border-gray-100 rounded text-sm text-gray-300 cursor-not-allowed">
                            &larr; Anterior
                        </span>
                    {% endif %}

                    {% if paginaActual < maxPaginas %}
                        <a href="{{ path('admin_jugador_index', app.request.query.all|merge({'page': paginaActual + 1})) }}" class="px-3 py-1 bg-white border border-gray-200 rounded text-sm text-gray-600 hover:bg-gray-100 hover:text-gray-900 transition-colors">
                            Siguiente &rarr;
                        </a>
                    {% else %}
                        <span class="px-3 py-1 bg-gray-50 border border-gray-100 rounded text-sm text-gray-300 cursor-not-allowed">
                            Siguiente &rarr;
                        </span>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
