{% extends 'admin/base_admin.html.twig' %}

{% set current_page = 'usuarios' %}

{% block title %}Usuarios{% endblock %}
{% block header_title %}Gestión de Usuarios{% endblock %}

{% block body %}

    <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">
        <div class="w-full md:w-1/3 relative">
            <input type="text" id="buscadorUsuarios" placeholder="Buscar por usuario o email..."
                   class="w-full pl-10 pr-4 py-2 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
            <svg class="w-5 h-5 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <table class="w-full text-left text-sm text-gray-600">
            <thead class="bg-gray-50 text-gray-900 font-semibold uppercase tracking-wider text-xs border-b border-gray-100">
            <tr>
                <th class="px-6 py-4">Usuario</th>
                <th class="px-6 py-4">Email</th>
                <th class="px-6 py-4 text-center">Rol</th>
                <th class="px-6 py-4 text-center">Reviews Hechas</th>
                <th class="px-6 py-4 text-center">Estado</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-gray-100" id="tablaUsuariosBody">
            {% for usuario in usuarios %}
                <tr class="group hover:bg-gray-50 transition-colors fila-usuario"
                    data-username="{{ usuario.username|lower }}"
                    data-email="{{ usuario.email|lower }}">

                    <td class="px-6 py-4">
                        <div class="flex items-center gap-3">
                            <img src="https://ui-avatars.com/api/?name={{ usuario.username|url_encode }}&background=random&color=fff&size=128&bold=true"
                                 alt="{{ usuario.username }}"
                                 class="h-8 w-8 rounded-full object-cover border border-gray-200">
                            <span class="font-bold text-gray-900 text-base">{{ usuario.username }}</span>
                        </div>
                    </td>

                    <td class="px-6 py-4 text-gray-500 font-mono text-xs">
                        {{ usuario.email }}
                    </td>

                    <td class="px-6 py-4 text-center">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-purple-50 text-purple-700 border border-purple-100">
                            {{ usuario.rol == '["ROLE_ADMIN"]' ? 'ADMINISTRADOR' : 'USUARIO' }}
                        </span>
                    </td>

                    <td class="px-6 py-4 text-center">
                        <span class="font-mono font-bold text-gray-700 bg-gray-50 px-2 py-1 rounded border border-gray-200">
                            {{ usuario.reviews_hechas }}
                        </span>
                    </td>

                    <td class="px-6 py-4 text-center">
                        {% if usuario.activo == 1 %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                Activo
                            </span>
                        {% else %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500">
                                Inactivo
                            </span>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const inputUsuario = document.getElementById('buscadorUsuarios');
            const filasUsuario = document.querySelectorAll('.fila-usuario');

            if(inputUsuario) {
                inputUsuario.addEventListener('input', function(e) {
                    const texto = e.target.value.toLowerCase();

                    filasUsuario.forEach(fila => {
                        const username = fila.getAttribute('data-username');
                        const email = fila.getAttribute('data-email');

                        if (username.includes(texto) || email.includes(texto)) {
                            fila.style.display = 'table-row';
                        } else {
                            fila.style.display = 'none';
                        }
                    });
                });
            }
        });
    </script>
{% endblock %}
