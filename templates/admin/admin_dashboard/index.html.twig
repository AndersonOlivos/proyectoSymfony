{% extends 'admin/base_admin.html.twig' %}

{% block title %}Dashboard - Estadísticas Generales{% endblock %}
{% block header_title %}Centro de Estadísticas{% endblock %}
{% set current_page = "dashboard" %}

{% block body %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500">Jugadores Registrados</p>
                    <p class="text-3xl font-bold text-gray-900 mt-1">{{ jugadoresRegistrados }}</p>
                </div>
                <div class="bg-blue-50 p-3 rounded-full text-blue-600">
                    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500">Valoraciones Totales</p>
                    <p class="text-3xl font-bold text-gray-900 mt-1">{{ valoracionesTotales }}</p>
                </div>
                <div class="bg-yellow-50 p-3 rounded-full text-yellow-600">
                    <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500">Rankings Activos</p>
                    <p class="text-3xl font-bold text-gray-900 mt-1">{{ rankingsActivos }}</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500">Más Votado (MVP)</p>
                    <p class="text-xl font-bold text-gray-900 mt-1 truncate">{{ nombreJugadorMasVotado }}</p>
                </div>
                <div class="bg-green-50 p-3 rounded-full text-green-600">
                    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-6 py-5 border-b border-gray-100 flex justify-between items-center bg-gray-50">
                <h3 class="font-bold text-gray-800 flex items-center gap-2">
                    <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                    Los 20 Jugadores con Mejor Valoración
                </h3>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-600">
                    <thead class="bg-white text-gray-500 border-b border-gray-100 font-medium text-xs uppercase tracking-wider">
                    <tr>
                        <th class="px-6 py-4">Jugador</th>
                        <th class="px-6 py-4">Puntos</th>
                        <th class="px-6 py-4 text-center">Nº Votos</th>
                        <th class="px-6 py-4 text-right">Nota Media</th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                    {% for jugador in jugadoresMejorValoracion %}
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-xs">
                                    {% if jugador.imagenUrl %}
                                        <img src="{{ jugador.imagenUrl }}" alt="Foto" class="h-8 w-8 rounded-full object-cover border border-gray-200">
                                    {% else %}
                                        <img src="https://ui-avatars.com/api/?name={{ jugador.nombre|url_encode }}&background=random&color=fff&size=128&bold=true"
                                             alt="{{ jugador.nombre }}"
                                             class="h-8 w-8 rounded-full object-cover border border-gray-200">
                                    {% endif %}
                                </div>
                                <span class="font-medium text-gray-900">{{ jugador.nombre }}</span>
                            </div>
                        </td>
                        <td class="px-6 py-4"><span class="bg-blue-50 text-blue-700 px-2.5 py-1 rounded text-xs font-semibold border border-blue-100">{{ jugador.puntos }}</span></td>
                        <td class="px-6 py-4 text-center font-medium">{{ jugador.numVotos }}</td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-1.5">
                                <span class="font-bold text-gray-900 text-base">{{ jugador.notaMedia }}</span>
                                <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 h-fit">
            <h3 class="font-bold text-gray-800 mb-6 flex items-center gap-2">
                <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                Rankings más Activos
            </h3>

            <div class="space-y-4">
                {% for ranking in rankingsMasActivos %}
                <div class="flex items-center justify-between p-3 rounded-xl hover:bg-gray-50 border border-transparent hover:border-gray-100 transition-colors">
                    <div class="flex items-center gap-3">
                        <div>
                            <p class="font-medium text-gray-900 text-sm">{{ ranking.titulo }}</p>
                            <p class="text-xs text-gray-500">{{ ranking.nombre }}</p>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="font-bold text-gray-900 text-sm">{{ ranking.votos }}</p>
                        <p class="text-[10px] text-gray-400 uppercase tracking-wider">Votos</p>
                    </div>
                </div>
                {% endfor %}

            <div class="mt-8 pt-6 border-t border-gray-100">
                <div class="bg-gray-50 p-4 rounded-xl border border-gray-100">
                    <h4 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">Resumen Rápido</h4>
                    <div class="flex justify-between items-center mb-2">
                        <span class="text-sm text-gray-600">Media global de notas</span>
                        <span class="text-sm font-bold text-gray-900">{{ resumenRapido.mediaGlobalNotas}} / 5.0</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-gray-600">Usuarios que han votado</span>
                        <span class="text-sm font-bold text-gray-900">{{ resumenRapido.usuariosHanVotado}} </span>
                    </div>
                </div>
            </div>
        </div>

    </div>
{% endblock %}
