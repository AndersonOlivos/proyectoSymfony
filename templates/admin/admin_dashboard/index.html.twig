{% extends 'admin/base_admin.html.twig' %}

{% block title %}Dashboard - Estadísticas y Valoraciones{% endblock %}
{% block header_title %}Estadísticas de Rendimiento y Valoraciones{% endblock %}
{% set current_page = "dashboard" %}
{% block body %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500">Valoración Media Global</p>
                    <div class="flex items-end gap-2">
                        <p class="text-3xl font-bold text-gray-900 mt-1">4.2</p>
                        <span class="text-sm text-gray-400 mb-1">/ 5.0</span>
                    </div>
                </div>
                <div class="bg-yellow-50 p-3 rounded-full text-yellow-500">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                </div>
            </div>
            <div class="mt-4 w-full bg-gray-100 rounded-full h-1.5">
                <div class="bg-yellow-400 h-1.5 rounded-full" style="width: 84%"></div>
            </div>
            <p class="text-xs text-gray-400 mt-2">Basado en todas las categorías</p>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500">Total Valoraciones</p>
                    <p class="text-3xl font-bold text-gray-900 mt-1">1,248</p>
                </div>
                <div class="bg-blue-50 p-3 rounded-full text-blue-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
                    </svg>
                </div>
            </div>
            <div class="mt-4 flex items-center text-sm">
                <span class="text-green-500 flex items-center font-medium">
                    +34
                </span>
                <span class="text-gray-400 ml-2">esta semana</span>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500">Categoría Mejor Valorada</p>
                    <p class="text-xl font-bold text-gray-900 mt-1 truncate">Primera División</p>
                </div>
                <div class="bg-purple-50 p-3 rounded-full text-purple-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
            <div class="mt-4 text-sm text-gray-500">
                Promedio de <span class="font-bold text-gray-800">4.8</span> estrellas
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500">MVP (Mejor Valorado)</p>
                    <p class="text-xl font-bold text-gray-900 mt-1">Alejandro G.</p>
                </div>
                <div class="bg-green-50 p-3 rounded-full text-green-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                    </svg>
                </div>
            </div>
            <div class="mt-4 text-sm text-gray-500">
                Ranking General #1
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-6 py-5 border-b border-gray-100 flex justify-between items-center bg-gray-50">
                <h3 class="font-bold text-gray-800 flex items-center gap-2">
                    <svg class="w-5 h-5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    Top Jugadores por Valoración
                </h3>
                <button class="text-sm text-blue-600 hover:text-blue-800 font-medium">Ver ranking completo</button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-600">
                    <thead class="bg-white text-gray-500 border-b border-gray-100 font-medium text-xs uppercase tracking-wider">
                    <tr>
                        <th class="px-6 py-3">Jugador</th>
                        <th class="px-6 py-3">Categoría</th>
                        <th class="px-6 py-3 text-center">Votos</th>
                        <th class="px-6 py-3 text-right">Valoración Media</th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="font-bold text-gray-900">1. Alejandro Gomez</div>
                                <span class="bg-yellow-100 text-yellow-700 text-[10px] px-2 py-0.5 rounded-full font-bold">MVP</span>
                            </div>
                        </td>
                        <td class="px-6 py-4"><span class="bg-blue-50 text-blue-700 px-2 py-1 rounded text-xs font-semibold">Primera</span></td>
                        <td class="px-6 py-4 text-center">42</td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <span class="font-bold text-gray-900">4.9</span>
                                <div class="flex text-yellow-400 text-xs">★★★★★</div>
                            </div>
                        </td>
                    </tr>
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4 font-medium text-gray-900">2. Carlos Ruiz</td>
                        <td class="px-6 py-4"><span class="bg-purple-50 text-purple-700 px-2 py-1 rounded text-xs font-semibold">Segunda</span></td>
                        <td class="px-6 py-4 text-center">38</td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <span class="font-bold text-gray-900">4.7</span>
                                <div class="flex text-yellow-400 text-xs">★★★★☆</div>
                            </div>
                        </td>
                    </tr>
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4 font-medium text-gray-900">3. Marta Diaz</td>
                        <td class="px-6 py-4"><span class="bg-blue-50 text-blue-700 px-2 py-1 rounded text-xs font-semibold">Primera</span></td>
                        <td class="px-6 py-4 text-center">51</td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <span class="font-bold text-gray-900">4.6</span>
                                <div class="flex text-yellow-400 text-xs">★★★★☆</div>
                            </div>
                        </td>
                    </tr>
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4 font-medium text-gray-900">4. Iker Casillas</td>
                        <td class="px-6 py-4"><span class="bg-orange-50 text-orange-700 px-2 py-1 rounded text-xs font-semibold">Tercera</span></td>
                        <td class="px-6 py-4 text-center">20</td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <span class="font-bold text-gray-900">4.5</span>
                                <div class="flex text-yellow-400 text-xs">★★★★☆</div>
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 h-fit">
            <h3 class="font-bold text-gray-800 mb-6">Satisfacción por Categoría</h3>

            <div class="space-y-6">
                <div>
                    <div class="flex justify-between items-end mb-1">
                        <span class="text-sm font-medium text-gray-700">Primera División</span>
                        <span class="text-sm font-bold text-gray-900">4.8 <span class="text-gray-400 text-xs">/5</span></span>
                    </div>
                    <div class="w-full bg-gray-100 rounded-full h-2">
                        <div class="bg-blue-500 h-2 rounded-full" style="width: 96%"></div>
                    </div>
                    <p class="text-xs text-gray-400 mt-1">Basado en 450 valoraciones</p>
                </div>

                <div>
                    <div class="flex justify-between items-end mb-1">
                        <span class="text-sm font-medium text-gray-700">Segunda División</span>
                        <span class="text-sm font-bold text-gray-900">4.2 <span class="text-gray-400 text-xs">/5</span></span>
                    </div>
                    <div class="w-full bg-gray-100 rounded-full h-2">
                        <div class="bg-purple-500 h-2 rounded-full" style="width: 84%"></div>
                    </div>
                    <p class="text-xs text-gray-400 mt-1">Basado en 320 valoraciones</p>
                </div>

                <div>
                    <div class="flex justify-between items-end mb-1">
                        <span class="text-sm font-medium text-gray-700">Tercera División</span>
                        <span class="text-sm font-bold text-gray-900">3.9 <span class="text-gray-400 text-xs">/5</span></span>
                    </div>
                    <div class="w-full bg-gray-100 rounded-full h-2">
                        <div class="bg-orange-500 h-2 rounded-full" style="width: 78%"></div>
                    </div>
                    <p class="text-xs text-gray-400 mt-1">Basado en 150 valoraciones</p>
                </div>

                <div>
                    <div class="flex justify-between items-end mb-1">
                        <span class="text-sm font-medium text-gray-700">Amateur</span>
                        <span class="text-sm font-bold text-gray-900">4.5 <span class="text-gray-400 text-xs">/5</span></span>
                    </div>
                    <div class="w-full bg-gray-100 rounded-full h-2">
                        <div class="bg-green-500 h-2 rounded-full" style="width: 90%"></div>
                    </div>
                    <p class="text-xs text-gray-400 mt-1">Basado en 80 valoraciones</p>
                </div>
            </div>

            <div class="mt-8 pt-6 border-t border-gray-100">
                <div class="flex items-center gap-3 p-4 bg-yellow-50 rounded-lg border border-yellow-100">
                    <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <div>
                        <p class="text-xs font-bold text-yellow-800">Nota Informativa</p>
                        <p class="text-xs text-yellow-700 mt-0.5">Los rankings se actualizan cada 24 horas basados en el feedback.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
